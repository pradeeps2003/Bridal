# Public (browser-safe)
# Local: http://localhost:3000
# Live:  https://rubi-makeovers.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Razorpay is not used. Advance is UPI-only so the site stays free.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics — only load in production AND after cookie consent
# GA4 measurement ID, e.g. G-XXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Meta Pixel ID, digits only
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console — HTML tag method
# 1. https://search.google.com/search-console  add URL prefix https://rubi-makeovers.vercel.app
# 2. Choose HTML tag. Copy only the content="...." value (not the whole meta tag)
# 3. Paste it here and in Vercel env as GSC_VERIFICATION, then Redeploy
# 4. Click Verify in Search Console
# 5. Sitemaps → submit sitemap.xml
GSC_VERIFICATION=

# Server-only — NEVER expose to browser or commit real values
APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0

# Optional notification providers
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: 21st.dev component library
API_KEY_21ST=
